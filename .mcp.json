{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "carbon-mcp": {
      "type": "http",
      "url": "https://mcp.carbondesignsystem.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CARBON_MCP_TOKEN}",
        "X-MCP-Session": "${CARBON_MCP_SESSION}"
      }
    }
  }
}